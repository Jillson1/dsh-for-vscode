{
  "name": "dsh-for-vscode",
  "displayName": "DSH for VS Code",
  "description": "在 VS Code 侧边栏中使用 DeepSeek Harness（DSH）网页界面，支持文件路径一键跳转到 VS Code 编辑区（含修改行精确定位），右键文件/选区即可添加到 DSH 输入框",
  "version": "0.3.0",
  "publisher": "Jillson1",
  "icon": "assets/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:dsh.panel",
    "onView:dsh.panel.secondary",
    "onView:dsh.changes",
    "onView:dsh.checkpoints",
    "onCommand:dsh.openPanel",
    "onCommand:dsh.openSecondary",
    "onCommand:dsh.openExternal",
    "onCommand:dsh.restart",
    "onCommand:dsh.stop",
    "onCommand:dsh.copyUrl",
    "onCommand:dsh.showLogs",
    "onCommand:dsh.bridge.retry",
    "onCommand:dsh.bridge.uninstall",
    "onCommand:dsh.copyLogs",
    "onCommand:dsh.addFileToDsh",
    "onCommand:dsh.addSelectionToDsh",
    "onCommand:dsh.diff.show",
    "onCommand:dsh.diff.revert",
    "onCommand:dsh.diff.keep",
    "onCommand:dsh.diff.revertAll",
    "onCommand:dsh.diff.clearMarks",
    "onCommand:dsh.change.next",
    "onCommand:dsh.change.prev",
    "onCommand:dsh.change.open",
    "onCommand:dsh.change.keep",
    "onCommand:dsh.change.revert",
    "onCommand:dsh.file.keepAll",
    "onCommand:dsh.file.revertAll",
    "onCommand:dsh.changes.refresh",
    "onCommand:dsh.session.keepAll",
    "onCommand:dsh.session.revertAll",
    "onCommand:dsh.diff.keepAll",
    "onCommand:dsh.checkpoints.refresh",
    "onCommand:dsh.checkpoint.diff",
    "onCommand:dsh.checkpoint.restore",
    "onCommand:dsh.quickEdit.selection",
    "onCommand:dsh.selection.quickEdit",
    "onCommand:dsh.selection.addToDsh",
    "onCommand:dsh.selection.submitReply"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "%dsh.container.title%",
          "icon": "assets/whale-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dsh-secondary",
          "title": "%dsh.container.title%",
          "icon": "assets/whale-icon.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "id": "dsh.panel",
          "name": "%dsh.view.panel.name%",
          "type": "webview"
        },
        {
          "id": "dsh.changes",
          "name": "%dsh.view.changes.name%"
        },
        {
          "id": "dsh.checkpoints",
          "name": "%dsh.view.checkpoints.name%"
        }
      ],
      "dsh-secondary": [
        {
          "id": "dsh.panel.secondary",
          "name": "%dsh.view.panelSecondary.name%",
          "type": "webview"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "dsh.getStarted",
        "title": "%dsh.walkthrough.title%",
        "description": "%dsh.walkthrough.description%",
        "steps": [
          {
            "id": "dsh.openPanel",
            "title": "%dsh.walkthrough.step.title%",
            "description": "%dsh.walkthrough.step.description%",
            "media": {
              "image": "assets/icon.png"
            },
            "completionEvents": [
              "onCommand:dsh.openPanel"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dsh.openPanel",
        "title": "%dsh.cmd.openPanel.title%",
        "icon": "$(panel)"
      },
      {
        "command": "dsh.openSecondary",
        "title": "%dsh.cmd.openSecondary.title%",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "dsh.openExternal",
        "title": "%dsh.cmd.openExternal.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "dsh.restart",
        "title": "%dsh.cmd.restart.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "dsh.stop",
        "title": "%dsh.cmd.stop.title%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dsh.copyUrl",
        "title": "%dsh.cmd.copyUrl.title%",
        "icon": "$(copy)"
      },
      {
        "command": "dsh.showLogs",
        "title": "%dsh.cmd.showLogs.title%",
        "icon": "$(output)"
      },
      {
        "command": "dsh.copyLogs",
        "title": "%dsh.cmd.copyLogs.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.bridge.retry",
        "title": "%dsh.cmd.bridgeRetry.title%"
      },
      {
        "command": "dsh.bridge.uninstall",
        "title": "%dsh.cmd.bridgeUninstall.title%"
      },
      {
        "command": "dsh.addFileToDsh",
        "title": "%dsh.cmd.addFileToDsh.title%",
        "category": "DSH",
        "icon": "assets/whale-title.svg"
      },
      {
        "command": "dsh.addSelectionToDsh",
        "title": "%dsh.cmd.addSelectionToDsh.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.diff.show",
        "title": "%dsh.cmd.diffShow.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.diff.revert",
        "title": "%dsh.cmd.diffRevert.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.diff.keep",
        "title": "%dsh.cmd.diffKeep.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.diff.revertAll",
        "title": "%dsh.cmd.diffRevertAll.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.diff.clearMarks",
        "title": "%dsh.cmd.diffClearMarks.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.change.next",
        "title": "%dsh.cmd.changeNext.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.change.prev",
        "title": "%dsh.cmd.changePrev.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.change.open",
        "title": "%dsh.cmd.changeOpen.title%",
        "icon": "$(go-to-file)",
        "category": "DSH"
      },
      {
        "command": "dsh.change.keep",
        "title": "%dsh.cmd.changeKeep.title%",
        "icon": "$(check)",
        "category": "DSH"
      },
      {
        "command": "dsh.change.revert",
        "title": "%dsh.cmd.changeRevert.title%",
        "icon": "$(discard)",
        "category": "DSH"
      },
      {
        "command": "dsh.file.keepAll",
        "title": "%dsh.cmd.fileKeepAll.title%",
        "icon": "$(check-all)",
        "category": "DSH"
      },
      {
        "command": "dsh.file.revertAll",
        "title": "%dsh.cmd.fileRevertAll.title%",
        "icon": "$(discard)",
        "category": "DSH"
      },
      {
        "command": "dsh.changes.refresh",
        "title": "%dsh.cmd.changesRefresh.title%",
        "icon": "$(refresh)",
        "category": "DSH"
      },
      {
        "command": "dsh.session.keepAll",
        "title": "%dsh.cmd.sessionKeepAll.title%",
        "icon": "$(check-all)",
        "category": "DSH"
      },
      {
        "command": "dsh.session.revertAll",
        "title": "%dsh.cmd.sessionRevertAll.title%",
        "icon": "$(discard)",
        "category": "DSH"
      },
      {
        "command": "dsh.diff.keepAll",
        "title": "%dsh.cmd.diffKeepAll.title%",
        "category": "DSH"
      },
      {
        "command": "dsh.checkpoints.refresh",
        "title": "%dsh.cmd.checkpointsRefresh.title%",
        "icon": "$(refresh)",
        "category": "DSH"
      },
      {
        "command": "dsh.checkpoint.diff",
        "title": "%dsh.cmd.checkpointDiff.title%",
        "icon": "$(diff)",
        "category": "DSH"
      },
      {
        "command": "dsh.checkpoint.restore",
        "title": "%dsh.cmd.checkpointRestore.title%",
        "icon": "$(history)",
        "category": "DSH"
      },
      {
        "command": "dsh.quickEdit.selection",
        "title": "%dsh.cmd.quickEditSelection.title%",
        "icon": "$(sparkle)",
        "category": "DSH"
      },
      {
        "command": "dsh.selection.quickEdit",
        "title": "%dsh.cmd.selectionQuickEdit.title%",
        "icon": "$(sparkle)",
        "category": "DSH"
      },
      {
        "command": "dsh.selection.addToDsh",
        "title": "%dsh.cmd.selectionAddToDsh.title%",
        "icon": "$(add)",
        "category": "DSH"
      },
      {
        "command": "dsh.selection.submitReply",
        "title": "%dsh.cmd.selectionSubmitReply.title%",
        "icon": "$(send)",
        "category": "DSH"
      }
    ],
    "keybindings": [
    {
      "command": "dsh.quickEdit.selection",
      "key": "alt+k",
      "when": "editorTextFocus && editorHasSelection"
    },
    {
      "command": "dsh.change.next",
      "key": "f8",
      "when": "editorTextFocus && dsh.hasFileChanges"
    },
    {
      "command": "dsh.change.prev",
      "key": "shift+f8",
      "when": "editorTextFocus && dsh.hasFileChanges"
    }
  ],
  "viewsWelcome": [
    {
      "view": "dsh.checkpoints",
      "contents": "%dsh.welcome.checkpoints%"
    }
  ],
  "menus": {
      "explorer/context": [
        {
          "command": "dsh.addFileToDsh",
          "group": "DSH@1",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "command": "dsh.addFileToDsh",
          "group": "DSH@1",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title": [
        {
          "command": "dsh.addFileToDsh",
          "group": "navigation@1",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "dsh.addSelectionToDsh",
          "group": "DSH@1",
          "when": "editorTextFocus && resourceScheme == file"
        },
        {
          "command": "dsh.quickEdit.selection",
          "group": "DSH@2",
          "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "dsh.selection.addToDsh",
          "when": "commentThread == dsh.selection",
          "group": "inline@1"
        },
        {
          "command": "dsh.selection.quickEdit",
          "when": "commentThread == dsh.selection",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "dsh.selection.submitReply",
          "when": "commentThread == dsh.selection",
          "group": "inline"
        }
      ],
      "view/item/context": [
        {
          "command": "dsh.change.open",
          "when": "view == dsh.changes && viewItem == dsh.change",
          "group": "inline"
        },
        {
          "command": "dsh.change.keep",
          "when": "view == dsh.changes && viewItem == dsh.change",
          "group": "1_dsh@1"
        },
        {
          "command": "dsh.change.revert",
          "when": "view == dsh.changes && viewItem == dsh.change",
          "group": "1_dsh@2"
        },
        {
          "command": "dsh.checkpoint.diff",
          "when": "view == dsh.checkpoints && viewItem == dsh.checkpointFile",
          "group": "inline"
        },
        {
          "command": "dsh.checkpoint.restore",
          "when": "view == dsh.checkpoints && viewItem == dsh.checkpoint",
          "group": "1_dsh@1"
        },
        {
          "command": "dsh.session.keepAll",
          "when": "view == dsh.changes && viewItem == dsh.session",
          "group": "1_dsh@1"
        },
        {
          "command": "dsh.session.revertAll",
          "when": "view == dsh.changes && viewItem == dsh.session",
          "group": "1_dsh@2"
        },
        {
          "command": "dsh.file.keepAll",
          "when": "view == dsh.changes && viewItem == dsh.file",
          "group": "1_dsh@1"
        },
        {
          "command": "dsh.file.revertAll",
          "when": "view == dsh.changes && viewItem == dsh.file",
          "group": "1_dsh@2"
        }
      ],
      "view/title": [
        {
          "command": "dsh.changes.refresh",
          "when": "view == dsh.changes",
          "group": "navigation@1"
        },
        {
          "command": "dsh.checkpoints.refresh",
          "when": "view == dsh.checkpoints",
          "group": "navigation@1"
        },
        {
          "command": "dsh.openExternal",
          "when": "view == dsh.panel || view == dsh.panel.secondary",
          "group": "navigation@1"
        },
        {
          "command": "dsh.restart",
          "when": "view == dsh.panel || view == dsh.panel.secondary",
          "group": "navigation@2"
        },
        {
          "command": "dsh.stop",
          "when": "view == dsh.panel || view == dsh.panel.secondary",
          "group": "navigation@3"
        },
        {
          "command": "dsh.copyUrl",
          "when": "view == dsh.panel || view == dsh.panel.secondary",
          "group": "navigation@4"
        },
        {
          "command": "dsh.showLogs",
          "when": "view == dsh.panel || view == dsh.panel.secondary",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "DSH",
      "properties": {
        "dsh.host": {
          "type": "string",
          "default": "127.0.0.1",
          "enum": [
            "127.0.0.1",
            "localhost",
            "[::1]"
          ],
          "markdownDescription": "%dsh.config.host%"
        },
        "dsh.port": {
          "type": "number",
          "default": 3080,
          "minimum": 0,
          "maximum": 65535,
          "markdownDescription": "%dsh.config.port%"
        },
        "dsh.autoStart": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%dsh.config.autoStart%"
        },
        "dsh.stopOnExit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%dsh.config.stopOnExit%"
        },
        "dsh.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%dsh.config.extraArgs%"
        },
        "dsh.bridge.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%dsh.config.bridgeEnabled%"
        },
        "dsh.workspaceRootIndex": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%dsh.config.workspaceRootIndex%"
        },
        "dsh.bridge.silenceWarning": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%dsh.config.bridgeSilenceWarning%"
        },
        "dsh.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%dsh.config.executablePath%"
        },
        "dsh.notify.onTurnComplete": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%dsh.config.notifyOnTurnComplete%"
        },
        "dsh.selection.threads.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%dsh.config.selectionThreads%"
        },
        "dsh.quickEdit.confirmBeforeSend": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%dsh.config.quickEditConfirm%"
        },
        "dsh.interaction.onlyWhenPanelHidden": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%dsh.config.interactionOnlyWhenPanelHidden%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs --test && node --test \"out/test/**/*.test.js\"",
    "package": "npm run compile && vsce package -o dsh-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "ai",
    "assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jillson1/dsh-for-vscode.git"
  },
  "homepage": "https://github.com/Jillson1/dsh-for-vscode#readme",
  "bugs": {
    "url": "https://github.com/Jillson1/dsh-for-vscode/issues"
  }
}